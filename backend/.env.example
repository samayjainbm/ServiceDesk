# ─────────────────────────────────────────────────────────────
# ServiceDesk — backend environment
# Copy to `.env` and fill in real values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# MySQL connection string used by Prisma
DATABASE_URL="mysql://user:password@localhost:3306/servicedesk"

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth (JWT) ───────────────────────────────────────────────
# Secret used to sign/verify JSON Web Tokens (use a long random string)
JWT_SECRET="change-me-to-a-long-random-string"

# ── Inventory role login ─────────────────────────────────────
# The Inventory role authenticates against these env credentials (not the DB)
LOGIN_ID="inventory"
LOGIN_PASSWORD="change-me"

# ── PA / Admin role login ────────────────────────────────────
# The PA role authenticates against these env credentials (not the DB)
LOGIN_PA="admin"
LOGIN_PA_PASSWORD="change-me"

# ── Google Sign-In (User role) ───────────────────────────────
# OAuth *Web* client ID used to verify Google idTokens sent by the app
GOOGLE_WEB_CLIENT_ID="<your-web-client-id>.apps.googleusercontent.com"

# ── Utilities / integrations ─────────────────────────────────
# Protects the seed route (POST /run-seed)
SEED_SECRET="change-me"
# Optional: webhook to mirror resolved complaints into a Google Sheet
GOOGLE_SHEET_WEBHOOK_URL=""
